-- Logica Click (ON/OFF)
MainButton.MouseButton1Click:Connect(function()
    IsOn = not IsOn
    if IsOn then
        StatusLed.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
        TextLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
        UIStroke.Color = Color3.fromRGB(0, 150, 255)
    else
        StatusLed.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        TextLabel.TextColor3 = Color3.fromRGB(0, 50, 150)
        UIStroke.Color = Color3.fromRGB(0, 35, 100)
    end
end)

-- Variabile pentru Drag & Resize
local dragging = false
local resizing = false
local dragStart = nil
local startPos = nil
local resizeStart = nil
local startSize = nil

-- Functie pentru incepe drag
local function StartDrag(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainButton.Position
    end
end

-- Functie pentru incepe resize
local function StartResize(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        resizing = true
        dragging = false
        resizeStart = input.Position
        startSize = MainButton.Size
    end
end

-- Logica Drag
MainButton.InputBegan:Connect(function(input)
    if not resizing then
        StartDrag(input)
    end
end)

MainButton.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- Logica Resize
ResizeHandle.InputBegan:Connect(function(input)
    StartResize(input)
end)

ResizeHandle.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        resizing = false
    end
end)

-- Logica Mouse Move (Drag si Resize)
UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        if dragging and dragStart and startPos then
            local delta = input.Position - dragStart
            MainButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        elseif resizing and resizeStart and startSize then
            local delta = input.Position - resizeStart
            local newWidth = startSize.X.Offset + delta.X
            
            -- Gaseste cea mai apropiata marime din tabel
            local treaptaAleasa = 3
            local distantaMinima = 99999
            
            for index = 1, 10 do
                local diferenta = math.abs(Dimensiuni[index].X - newWidth)
                if diferenta < distantaMinima then
                    distantaMinima = diferenta
                    treaptaAleasa = index
                end
            end
            
            local nouaMarime = Dimensiuni[treaptaAleasa]
            MainButton.Size = UDim2.new(0, nouaMarime.X, 0, nouaMarime.Y)
        end
    end
end)

print("✓ Kawatan Lagger GUI incarcat cu succes!")
