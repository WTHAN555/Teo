-- Sterge versiunea veche pentru a curata ecranul
local vechiulGui = game:GetService("CoreGui"):FindFirstChild("KawatanLaggerGui") or game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("KawatanLaggerGui")
if vechiulGui then vechiulGui:Destroy() end

-- Interfata de baza
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "KawatanLaggerGui"
ScreenGui.ResetOnSpawn = false

local succes, eroarea = pcall(function()
    ScreenGui.Parent = game:GetService("CoreGui")
end)
if not succes then
    ScreenGui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
end

local IsOn = false

-- TABELUL DE DIMENSIUNI (1 pana la 10)
local Dimensiuni = {
    [1] = {X = 140, Y = 40},
    [2] = {X = 165, Y = 43},
    [3] = {X = 190, Y = 45}, -- Pornim cu aceasta marime compacta
    [4] = {X = 215, Y = 48},
    [5] = {X = 240, Y = 50},
    [6] = {X = 265, Y = 53},
    [7] = {X = 290, Y = 55},
    [8] = {X = 315, Y = 58},
    [9] = {X = 340, Y = 60},
    [10] = {X = 365, Y = 65}
}

local TreaptaCurenta = 3
local MarimeConfigurata = Dimensiuni[TreaptaCurenta]

-- Butonul Principal (Fundalul Negru)
local MainButton = Instance.new("TextButton")
MainButton.Name = "MainButton"
MainButton.Size = UDim2.new(0, MarimeConfigurata.X, 0, MarimeConfigurata.Y)
MainButton.Position = UDim2.new(1, -MarimeConfigurata.X - 10, 0, 10) -- Dreapta-sus
MainButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
MainButton.Text = ""
MainButton.BorderSizePixel = 0
MainButton.AutoButtonColor = false
MainButton.Parent = ScreenGui

-- Stilul marginilor
local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = MainButton

local UIStroke = Instance.new("UIStroke")
UIStroke.Color = Color3.fromRGB(0, 35, 100)
UIStroke.Thickness = 2
UIStroke.Parent = MainButton

-- Stratul de text
local TextLabel = Instance.new("TextLabel")
TextLabel.Name = "ButtonText"
TextLabel.Size = UDim2.new(1, 0, 1, 0)
TextLabel.BackgroundTransparency = 1
TextLabel.Text = "Kawatan Lagger"
TextLabel.Font = Enum.Font.MontserratBold
TextLabel.TextColor3 = Color3.fromRGB(0, 50, 150)
TextLabel.TextScaled = true
TextLabel.ZIndex = 3
TextLabel.Parent = MainButton

local UIPadding = Instance.new("UIPadding")
UIPadding.PaddingTop = UDim.new(0.15, 0)
UIPadding.PaddingBottom = UDim.new(0.15, 0)
UIPadding.PaddingLeft = UDim.new(0.18, 0)
UIPadding.PaddingRight = UDim.new(0.1, 0)
UIPadding.Parent = TextLabel

-- Indicatorul LED din coltul stanga-jos
local StatusLed = Instance.new("Frame")
StatusLed.Name = "StatusLed"
StatusLed.Size = UDim2.new(0, 10, 0, 10)
StatusLed.Position = UDim2.new(0, 8, 1, -18)
StatusLed.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Rosu la inceput
StatusLed.BorderSizePixel = 0
StatusLed.ZIndex = 5
StatusLed.Parent = MainButton

local LedCorner = Instance.new("UICorner")
LedCorner.CornerRadius = UDim.new(1, 0)
LedCorner.Parent = StatusLed

-- Indicatorul de Resize din coltul dreapta-jos
local ResizeHandle = Instance.new("ImageButton")
ResizeHandle.Name = "ResizeHandle"
ResizeHandle.Size = UDim2.new(0, 12, 0, 12)
ResizeHandle.Position = UDim2.new(1, -12, 1, -12)
ResizeHandle.BackgroundTransparency = 1
ResizeHandle.Image = "rbxassetid://6031304910"
ResizeHandle.ImageColor3 = Color3.fromRGB(0, 50, 150)
ResizeHandle.ZIndex = 5
ResizeHandle.Parent = MainButton

-- Logica de click (ON / OFF)
MainButton.MouseButton1Click:Connect(function()
    IsOn = not IsOn
    if IsOn then
        StatusLed.BackgroundColor3 = Color3.fromRGB(0, 255, 100) -- Verde
        TextLabel.TextColor3 = Color3.fromRGB(0, 150, 255)
        UIStroke.Color = Color3.fromRGB(0, 100, 255)
    else
        StatusLed.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Rosu
        TextLabel.TextColor3 = Color3.fromRGB(0, 50, 150)
        UIStroke.Color = Color3.fromRGB(0, 35, 100)
    end
end)

-- Logica stabila de Drag si Resize
local UserInputService = game:GetService("UserInputService")
local dragging, dragInput, dragStart, startPos
local resizing, resizeStart, startSize

MainButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainButton.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

MainButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

ResizeHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        resizing = true
        dragging = false
        resizeStart = input.Position
        startSize = MainButton.Size
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then resizing = false end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - resizeStart
        local tintaX = startSize.X.Offset + delta.X
       
        -- Sistem nou si curat de detectare a treptei (1-10)
        local treaptaAleasa = 3
        local distantaMinima = 99999
       
        for index = 1, 10 do
            local diferenta = math.abs(Dimensiuni[index].X - tintaX)
            if diferenta < distantaMinima then
                distantaMinima = diferenta
                treaptaAleasa = index
            end
        end
       
        local nouaMarime = Dimensiuni[treaptaAleasa]
        MainButton.Size = UDim2.new(0, nouaMarime.X, 0, nouaMarime.Y)
       
    elseif dragging and dragInput and input == dragInput then
        local delta = input.Position - dragStart
        MainButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)


