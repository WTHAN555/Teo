-- Sterge versiunea veche pentru a curata ecranul
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local vechiulGui = CoreGui:FindFirstChild("KawatanLaggerGui") or PlayerGui:FindFirstChild("KawatanLaggerGui")
if vechiulGui then 
    vechiulGui:Destroy() 
end

-- Interfata de baza
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "KawatanLaggerGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.DisplayOrder = 999

-- Incearca sa pui in CoreGui, daca nu merge, pui in PlayerGui
local success = pcall(function()
    ScreenGui.Parent = CoreGui
end)
if not success then
    ScreenGui.Parent = PlayerGui
end

local IsOn = false

-- TABELUL DE DIMENSIUNI (1 pana la 10)
local Dimensiuni = {
    [1] = {X = 140, Y = 40},
    [2] = {X = 165, Y = 43},
    [3] = {X = 190, Y = 45},
    [4] = {X = 215, Y = 48},
    [5] = {X = 240, Y = 50},
    [6] = {X = 265, Y = 53},
    [7] = {X = 290, Y = 55},
    [8] = {X = 315, Y = 58},
    [9] = {X = 340, Y = 60},
    [10] = {X = 365, Y = 65}
}

local TreaptaCurenta = 3
local MarimeConfigurata = Dimensiuni[TreaptaCurenta]

-- Butonul Principal
local MainButton = Instance.new("TextButton")
